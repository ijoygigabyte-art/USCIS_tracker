# ──────────────────────────────────────────────────
# USCIS Case Status Tracker — Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

# Comma-separated receipt numbers to track
USCIS_RECEIPT_NUMBERS=IOE0912345678

# How often to poll for updates (in hours)
USCIS_POLL_INTERVAL_HOURS=6

# Desktop notifications (Windows toast)
USCIS_DESKTOP_NOTIFY=true

# Email notifications (optional)
USCIS_EMAIL_NOTIFY=false
USCIS_SMTP_SERVER=smtp.gmail.com
USCIS_SMTP_PORT=587
USCIS_SMTP_USERNAME=
USCIS_SMTP_PASSWORD=
USCIS_EMAIL_TO=

# Dashboard settings
USCIS_DASHBOARD_HOST=127.0.0.1
USCIS_DASHBOARD_PORT=5000
